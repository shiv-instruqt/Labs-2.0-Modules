}

# Was module "lb" (modules/load-balancer). The backends map used to come from
# module.blue.output.address and module.green.output.address.
local "upstream_blocks" {
  value = join("\n", [for name, address in { blue = "10.0.200.11", green = "10.0.200.12" } : "upstream ${name} { server ${address}:80; }"])
}

resource "container" "lb" {
  image {
    name = "nginx:1.27"
  }

  environment = {
    LB_UPSTREAMS = local.upstream_blocks
    LB_ACTIVE    = variable.live_color
  }

  # The server block is written with a quoted heredoc so nginx variables such
  # as $host stay literal. __ACTIVE__ is then replaced with the live backend.
  command = [
    "/bin/bash",
    "-c",
    <<-EOT
      set -e
      CONF=/etc/nginx/conf.d/default.conf
      {
        echo "# Upstreams generated by the load-balancer module"
        printf '%s\n' "$LB_UPSTREAMS"
        cat <<'NGINX'

      server {
        listen 80;

        location / {
          # Change the upstream name below to switch traffic, then run:
          #   nginx -t && nginx -s reload
          proxy_pass http://__ACTIVE__;

          proxy_set_header Host $host;
          add_header X-Served-By $upstream_addr always;
        }

        location = /lb-health {
          default_type text/plain;
          return 200 "ok\n";
        }
      }
      NGINX
      } > "$CONF"
      sed -i "s/__ACTIVE__/$LB_ACTIVE/" "$CONF"
      exec nginx -g 'daemon off;'
    EOT
  ]

  port {
    local = 80
  }

  resources {
    cpu    = 250
    memory = 256
  }

  network {
    id         = resource.network.main.meta.id
    ip_address = "10.0.200.10"
    aliases    = ["lb"]
  }
}
